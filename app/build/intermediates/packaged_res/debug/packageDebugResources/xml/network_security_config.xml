<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi ini HANYA untuk development lokal dengan Laragon.
  10.0.2.2       -> alamat host machine saat diakses dari Android EMULATOR
  192.168.0.0/16 -> jaringan LAN rumah/kantor umum, untuk akses dari HP fisik
                    di WiFi yang sama dengan PC Laragon (opsional, sesuaikan)

  SEBELUM RILIS PRODUKSI:
  - Hapus / kosongkan domain-config di bawah ini
  - Pastikan app/build.gradle release build type memakai usesCleartextTraffic = false
  - Gunakan HTTPS (domain-perusahaan.com) sebagai BASE_URL final
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- IP LAN Laragon untuk device fisik. HARUS sama persis dengan
             BuildConfig.BASE_URL di app/build.gradle. IP ini berubah kalau
             PC reconnect ke WiFi/dapat DHCP lease baru (cek ulang lewat
             `ipconfig` di PC kalau tiba-tiba ERR_CLEARTEXT_NOT_PERMITTED
             atau ERR_CONNECTION_TIMED_OUT muncul lagi). Diupdate 2026-09-19. -->
        <domain includeSubdomains="false">192.168.18.46</domain>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
