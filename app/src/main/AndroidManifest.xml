<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet & network state -> komunikasi ke Laravel API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lokasi -> Native GPS (Section 8 & 9 blueprint) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service -> Section 10 blueprint -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifikasi status tracking (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot -> auto-resume tracking session bila diperlukan -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Kiosk / Dedicated Device (Phase H, section 27) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".SalesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.SalesApp"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Peta rute harian + follow-me (Section 25). Dibuka dari WebView:
             window.Android.openRouteMap() -->
        <activity
            android:name=".map.MapActivity"
            android:exported="false"
            android:label="@string/map_title"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Native Foreground Location Service (Section 10) -->
        <service
            android:name=".location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Section 9: auto-resume tracking setelah device reboot.
             Hanya lanjut bila sesi memang aktif + token masih ada + izin lokasi masih diberikan.
             Catatan: sebagian OEM (Xiaomi/Oppo/Vivo) memblokir autostart kecuali diizinkan
             manual di pengaturan device — itu batasan vendor, bukan bug. -->
        <receiver
            android:name=".location.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Sync Manager worker dijalankan via WorkManager, tidak perlu deklarasi service manual -->

    </application>

</manifest>
